# ---- 必須 ----
DB_PASSWORD=change-me-to-a-long-random-string

# ---- Discord 通知(空なら通知しない) ----
DISCORD_WEBHOOK_URL=
# 失敗したときにメンションするユーザーID(空ならメンションなし)
DISCORD_MENTION_USER_ID=

# ---- Cloudflare Access ----
# Access アプリの「Application Audience (AUD) Tag」。設定すると JWT を検証し、Access を通らないアクセスは全部拒否します。
# 空のままだと誰でも操作できるので、公開前に必ず設定してください。
CF_ACCESS_AUD=
CF_ACCESS_TEAM_DOMAIN=clusters-prj.cloudflareaccess.com
# Discord 通知に付けるリンク
BASE_URL=https://patchdeck.clusters-prj.com

# ---- 動作 ----
SSH_USER=root
# 0 で定期スキャン無効
SCAN_INTERVAL_HOURS=6
SCAN_ON_STARTUP=true
# 同時に作業するホスト数(dell のメモリが厳しいので控えめ)
MAX_PARALLEL=3
# 1コマンドの最大秒数
CMD_TIMEOUT=1800
SSH_CONNECT_TIMEOUT=10
